{
  "framework": "vite",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist",
  "installCommand": "npm --prefix app install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://fyydev-claimtrace-backend.hf.space/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
