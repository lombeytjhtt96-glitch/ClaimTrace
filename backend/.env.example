# ==============================================================================
# CLAIMTRACE JKN - ENTERPRISE BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Portal Administrator Pengawasan Pra-Pembayaran Klaim JKN BPJS Kesehatan
# Salin ke backend/.env dan isi rahasia/kredensial Anda sebelum menjalankan
# ==============================================================================

# 1. Server Runtime & Public Origin
APP_ENV=production
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
CLAIMTRACE_PUBLIC_URL=http://localhost:3000

# 2. Cryptographic Session, JWT & Zero-PHI Tokenization Secrets (UU PDP No. 27/2022)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_IDLE_TIMEOUT_MINUTES=15
CLAIMTRACE_SESSION_SECRET=
CLAIMTRACE_NIK_SALT=

# 3. Zero-Trust Access Control, CORS & Proxy Hardening
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://claimtrace.bpjs-kesehatan.go.id
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
CLAIMTRACE_TRUST_PROXY_HEADERS=0
CLAIMTRACE_TRUSTED_PROXIES=127.0.0.1,::1
CLAIMTRACE_STRICT_API_AUTH=0
CLAIMTRACE_ALLOW_TEST_HEADERS=0
CLAIMTRACE_ENFORCE_RECAPTCHA_IN_TEST=0

# 4. Multi-Layer Bot Protection (Google reCAPTCHA v2 + v3 / Enterprise)
RECAPTCHA_ENFORCE_ALL_LAYERS=v2_v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5
RECAPTCHA_ENTERPRISE_PROJECT_ID=
RECAPTCHA_ENTERPRISE_SITE_KEY=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_SECRET_KEY=
RECAPTCHA_ENTERPRISE_MIN_SCORE=0.5

# 5. Sovereign On-Premise AI & Deterministic Rule Engine
# Kosongkan agar tetap berjalan deterministik lokal tanpa mengirim PHI ke pihak luar
CLAIMTRACE_LLM_ENDPOINT=
CLAIMTRACE_LLM_API_KEY=

# 6. Enterprise SMTP Dispatch (MFA OTP & Pemulihan Kata Sandi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bpjs-kesehatan.go.id
SMTP_USE_TLS=1

# 7. BPJS Kesehatan Audit Governance & Data Residency
DATA_RESIDENCY_REGION=ID-JKT-ONPREMISE
ZERO_PHI_ENFORCED=true
AUDIT_LEDGER_HASH_ALG=SHA-256
REGULATION_FRAMEWORK="Perpres No. 82/2018; Permenkes No. 26/2021; UU PDP No. 27/2022"
