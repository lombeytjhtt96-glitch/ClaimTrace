# ==============================================================================
# ClaimTrace JKN DSS — Backend Environment Configuration Example
# Copy to `backend/.env` and replace placeholder secrets before production use.
# ==============================================================================

APP_ENV=development
ENVIRONMENT=sandbox
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 1. Relational OLTP (PostgreSQL 16/18 + SQLAlchemy 2.0 + Alembic)
DATABASE_URL=postgresql+psycopg://claimtrace:claimtrace_local_dev@127.0.0.1:5432/claimtrace_db
CLAIMTRACE_DISABLE_POSTGRES=0

# 2. Cache, Rate Limiter & Async Background Worker (Redis + ARQ + SlowAPI)
REDIS_URL=redis://127.0.0.1:6379/0
CLAIMTRACE_ARQ_QUEUE=claimtrace:arq
CLAIMTRACE_DISABLE_REDIS=0

# 3. On-Premise S3 Object Storage (MinIO) & Scheduled Backups
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=claimtrace_minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_SECURE=0
MINIO_BUCKET_BACKUPS=claimtrace-backups
MINIO_BUCKET_DOCUMENTS=claimtrace-documents
CLAIMTRACE_BACKUP_RETENTION_COUNT=14
CLAIMTRACE_BACKUP_CRON="0 19 * * * (02:00 WIB Harian)"

# 4. Enterprise SSO (Keycloak OIDC / SAML 2.0) & Session Security
KEYCLOAK_URL=http://127.0.0.1:8180
KEYCLOAK_REALM=claimtrace-jkn
KEYCLOAK_CLIENT_ID=claimtrace-web
KEYCLOAK_REDIRECT_URI=http://localhost:8080/login
CLAIMTRACE_SESSION_SECRET=CHANGE_ME_WITH_64_BYTE_HEX_SECRET
CLAIMTRACE_NIK_SALT=CHANGE_ME_BPJS_ENTERPRISE_HMAC_SALT
CLAIMTRACE_STRICT_API_AUTH=1
CLAIMTRACE_ALLOW_JURY_DEMO=1
CLAIMTRACE_TRUST_PROXY_HEADERS=1
CLAIMTRACE_TRUSTED_PROXIES=127.0.0.1,::1
SESSION_IDLE_TIMEOUT_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 5. FastAPI-Mail + Jinja2 & SMTP Notifications
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=noreply@claimtrace.internal
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM=noreply@claimtrace.internal
MAIL_FROM_NAME="ClaimTrace JKN DSS"
MAIL_STARTTLS=1
MAIL_SSL_TLS=0
CLAIMTRACE_MAIL_LIVE_SMTP=0

# 6. Triage & Governance Thresholds (UU PDP No. 27/2022 & Perpres 82/2018)
REGULATION_FRAMEWORK="UU PDP No. 27/2022 & Perpres No. 82/2018"
ZERO_PHI_ENFORCED=true
REAL_JKN_DATA_USED=false
TRIAGE_RED_MIN=70
TRIAGE_YELLOW_MIN=40
TRIAGE_GREEN_MAX=39
BERITA_ACARA_SLA_WORKDAYS=10

# ==========================================================================
# 6. Extended Security, AI/LLM, Email Dispatch, & Fraud Engine Config
# ==========================================================================
CLAIMTRACE_PUBLIC_URL=http://localhost:3000
TARGET_UPTIME_SLA_PERCENT=99.998
MAX_AVG_LATENCY_MS=1000
LOAD_MODELS_IN_MEMORY_ON_STARTUP=true
# ------------------------------------------------------------------------------
# 2. Cryptographic Session, JWT, AES-256 & Zero-PHI Tokenization Secrets
# ------------------------------------------------------------------------------
SECRET_KEY=
ALGORITHM=HS256
DATA_ENCRYPTION_ALG=AES-256-GCM
CLAIMTRACE_AES256_KEY=
TOKENIZATION_STANDARD=
# ------------------------------------------------------------------------------
# 3. Zero-Trust Access Control, CORS & Reverse Proxy Hardening
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://bpjs-kesehatan.go.id,https://claimtrace.bpjs-kesehatan.go.id
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
CLAIMTRACE_ALLOW_TEST_HEADERS=0
CLAIMTRACE_ENFORCE_RECAPTCHA_IN_TEST=0
# Set 0 pada deployment lapangan BPJS agar akun demo bawaan tidak dimuat (hanya .directory_accounts.json)
CLAIMTRACE_ALLOW_DEMO_ACCOUNTS=1
# ------------------------------------------------------------------------------
# 4. Multi-Layer Bot & Credential Stuffing Protection (reCAPTCHA)
# ------------------------------------------------------------------------------
RECAPTCHA_ENFORCE_ALL_LAYERS=v2_v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_V2_SECRET_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5
RECAPTCHA_ENTERPRISE_PROJECT_ID=bpjs-claimtrace-jkn-2026
RECAPTCHA_ENTERPRISE_SITE_KEY=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_ENTERPRISE_SECRET_KEY=
RECAPTCHA_ENTERPRISE_MIN_SCORE=0.5
# ------------------------------------------------------------------------------
# 5. Sovereign On-Premise AI
# Biarkan endpoint kosong untuk memaksa ON_PREMISE_DETERMINISTIC_MODE
# ------------------------------------------------------------------------------
CLAIMTRACE_LLM_ENDPOINT=
CLAIMTRACE_LLM_API_KEY=
AI_GOVERNANCE_MODE=ON_PREMISE_DETERMINISTIC_ONLY
CEK_1_DATA_INTERNAL_ONLY=true
CEK_2_ENTERPRISE_ACCOUNT_ONLY=true
CEK_3_MODEL_TRAINING_OPT_OUT=true
CEK_4_HUMAN_IN_THE_LOOP_MANDATORY=true
ENABLE_LOCAL_RULE_ENGINE_FALLBACK=true
# ------------------------------------------------------------------------------
# 6. Enterprise SMTP Notification Dispatch (MFA OTP & Password Recovery)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bpjs-kesehatan.go.id
SMTP_USE_TLS=1
# ------------------------------------------------------------------------------
# 6B. Sendcorex Transactional Email API (Primary - OTP & Reset Password)
# Isi SENDCOREX_API_KEY di backend/.env untuk mengaktifkan Sendcorex (corexsend.com / domain terverifikasi)
# ------------------------------------------------------------------------------
SENDCOREX_API_KEY=
SENDCOREX_API_URL=https://mail.sendcorex.com/v3.0/send
SENDCOREX_FROM_EMAIL=claimtrace-portal@corexsend.com
SENDCOREX_FROM_NAME=ClaimTrace Portal
SENDCOREX_REPLY_TO=
SENDCOREX_WEBHOOK_SECRET=
# ------------------------------------------------------------------------------
# 7. BPJS Kesehatan Audit Governance, BEA Mapping & Data Residency Metadata
# ------------------------------------------------------------------------------
DATA_RESIDENCY_REGION=ID-JKT-ONPREMISE
AUDIT_LEDGER_HASH_ALG=SHA-256
IT_GOVERNANCE_STANDARD=COBIT 2019; ISO 27001; ISO 27701 (ROPA & DPIA); ISO 20000; ISO 9001
# Pemetaan BPJS Kesehatan Enterprise Architecture (BEA)
BEA_CORE_PROCESS=C03.04.02_Pengelolaan_Klaim_Faskes
BEA_UPSTREAM_PROCESSES=C01_Kepesertaan,C02_Kolektibilitas,C03_Pelayanan_Kesehatan
BEA_DOWNSTREAM_PROCESS=S06_Keuangan_InMonica
BEA_INTEGRATED_SYSTEMS=VClaim,VIDI_Smart_Vedika,HFIS,FRISTA,Mobile_JKN,SIGAP,AUDIA,In-Monica
# ------------------------------------------------------------------------------
# 8. Konfigurasi Matriks Bukti 3 Lapis & Parameter Operasional Klaim FKRTL
# ------------------------------------------------------------------------------
FUSION_WEIGHT_S1_SPATIOTEMPORAL=0.50
FUSION_WEIGHT_S2_SDMK_CREDENTIAL=0.30
FUSION_WEIGHT_S3_MOBILE_PRESENCE=0.20
HARD_TRIGGER_EXPIRED_SIP=true
MAX_DPJP_DAILY_PATIENT_LOAD=60
# ------------------------------------------------------------------------------
# 9. Skema 5 Dataset Data Sampel BPJS Kesehatan & Metrik Evaluasi (hkeval)
# ------------------------------------------------------------------------------
CALIBRATED_SYNTHETIC_ROWS=3002
BPJS_SAMPLE_SCHEMA_KEYS=PSTV01,PSTV02,PSTV15,FKP02,PNK02,PNK17,PNK18,FKL02,FKL18,FKL19,FKL20,FKL21,FKL22,FKL23,FKL24,FKL30,FKL47,FKL48
COST_DISCREPANCY_METRIC=FKL47_TAGIH_VS_FKL48_VERIFIKASI
EVAL_VERIFIER_CAPACITY_K=50
EVAL_REALISTIC_FRAUD_RATE=0.02
EVAL_CI_BOOTSTRAP_GROUP=faskes_id
