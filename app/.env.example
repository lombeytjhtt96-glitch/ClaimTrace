# ==============================================================================
# CLAIMTRACE JKN - FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# Portal Administrator Pengawasan Pra-Pembayaran Klaim JKN BPJS Kesehatan
# Catatan: Variabel VITE_* disematkan ke bundle klien; JANGAN menaruh secret key.
# ==============================================================================

# Backend FastAPI URL (kosongkan di produksi jika memakai reverse proxy / same-origin)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_API_VERSION=/api/v1

# Application & Regulatory Metadata
VITE_APP_ENV=production
VITE_APP_NAME="ClaimTrace DSS BPJS Kesehatan"
VITE_APP_VERSION=1.0.0
VITE_PORTAL_TITLE="Portal Verifikator Klaim JKN"
VITE_REGULATORY_STANDARD="Perpres 82/2018 · Permenkes 26/2021 · UU PDP 27/2022"

# Multi-Layer reCAPTCHA Public Site Keys
VITE_ENABLE_CAPTCHA=true
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_V2_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# High-Security Administrator Session & Zero-Trust Controls
VITE_ENABLE_MFA=true
VITE_ENABLE_PIN_VERIFICATION=true
VITE_ENABLE_EMAIL_OTP=true
VITE_ENABLE_DEVICE_SESSION_GUARD=true
VITE_ENABLE_STRICT_IP_LOCK=true
VITE_ENABLE_SINGLE_SESSION_DEFAULT=true
VITE_ENABLE_AUDIT_TRAIL=true
VITE_ZERO_PHI_STRICT_MODE=true
VITE_ENABLE_LIGHT_FIRST_AUTH=true
VITE_ENABLE_TAB_ERROR_BOUNDARY=true

# Session & SLA Thresholds
VITE_SESSION_TIMEOUT_MINUTES=15
VITE_SESSION_MAX_DURATION_MINUTES=60
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_MAX_PIN_ATTEMPTS=3
VITE_BAHV_SLA_MAX_DAYS=14


# ==============================================================================
# STATSIG, GROWTHBOOK & LAUNCHDARKLY FEATURE FLAGS & TELEMETRY
# ==============================================================================
VITE_STATSIG_CLIENT_KEY=client-xuGhZIFcJXG4W5mMcIvGmf72EuWFy93Ezdbd3F9nXU6
VITE_GROWTHBOOK_API_HOST=https://cdn.growthbook.io
VITE_GROWTHBOOK_CLIENT_KEY=sdk-rqlBt32gkZkhGZV7
VITE_LAUNCHDARKLY_CLIENT_ID=6afc1e074dc6f50743d0afb9
VITE_LAUNCHDARKLY_PROJECT_KEY=default
